# Copy to .env and fill in. .env is gitignored.
DEFAULT_SESSION=default
# Comma-separated session ids for multi-session, e.g. alice,bob
# SESSIONS=default
# Session yang dibuat via SESIBUAT otomatis ikut connect (tersimpan di .data/sessions/_registry.sqlite)
# Supervisor: restart child tiap N jam (0 = matikan cycle restart)
# CYCLE_HOURS=10
COMMAND_PREFIX=
PAIRING_MODE=both
# Nomor WA default untuk pairing kode (bot minta kode 8 karakter otomatis).
# Session hasil SESIBUAT memakai nomornya sendiri, ini hanya fallback.
# PAIRING_PHONE=628123456789
LOG_LEVEL=info
STORE_PATH=.auth/state.sqlite
# Owner phone numbers, digits only, country code, NO +, NO 0 prefix, comma-separated
# OWNERS = super admin (kelola session, lihat transaksi semua session)
# Example: OWNERS=628123456789,628987654321
OWNERS=
# Mark incoming messages as read (blue ticks): true / false
AUTOREAD=false
# PPOB data: one SQLite file per session -> <SESSION_DIR>/<sessionId>.sqlite
SESSION_DIR=.data/sessions
OWNER_PIN=1234
