# Copy to .env and fill in. .env is gitignored.
DEFAULT_SESSION=owner
# Comma-separated session ids for multi-session, e.g. alice,bob
# SESSIONS=owner
# Session yang dibuat via SESIBUAT otomatis ikut connect (tersimpan di .data/sessions/_registry.sqlite)
# Supervisor: restart child tiap N jam (0 = matikan cycle restart)
# CYCLE_HOURS=10
# Supervisor: auto-restart saat file kode (index.js, src/**, .env) berubah (true/false)
# WATCH_CHANGES=true
COMMAND_PREFIX=
PAIRING_MODE=both
# Nomor WA default untuk pairing kode (bot minta kode 8 karakter otomatis).
# Session hasil SESIBUAT memakai nomornya sendiri, ini hanya fallback.
# PAIRING_PHONE=628123456789
LOG_LEVEL=info
STORE_PATH=.auth/state.sqlite
# Owner phone numbers, digits only, country code, NO +, NO 0 prefix, comma-separated
# OWNERS = super admin (kelola session, lihat transaksi semua session)
# Example: OWNERS=628123456789,628987654321
OWNERS=
# Mark incoming messages as read (blue ticks): true / false
AUTOREAD=false
# Perilaku natural seperti manusia: normal | fast | off (delay balasan selalu < 500ms)
HUMAN_MODE=normal
# Penanganan nomor asing non-mitra: ignore (diam) | once (1x/24 jam) | always (selalu balas)
UNKNOWN_SENDER_MODE=ignore
# Abaikan pesan grup (@g.us) secara diam-diam: true / false
IGNORE_GROUPS=true
# PPOB data: one SQLite file per session -> <SESSION_DIR>/<sessionId>.sqlite
SESSION_DIR=.data/sessions
OWNER_PIN=1234
# Supplier ICS: public base URL of this bot for the supplier webhook callback,
# e.g. https://bot.example.com (no trailing slash needed)
WEBHOOK_BASE_URL=
# Local port the webhook server listens on
WEBHOOK_PORT=8080
# Supplier API base (default ICS production)
# ICS_BASE_URL=https://api.ics-store.my.id
# Fallback API key when a session admin has not run APIKEY.KEY yet
# ICS_API_KEY=
# Cache TTL status/harga produk ICS dalam detik untuk CH & BELI (default 60)
PRODUCT_CACHE_TTL_SEC=60
# Interval cron auto-sync produk ICS dalam menit (default 15; 0 = matikan cron)
SYNC_INTERVAL_MIN=15
